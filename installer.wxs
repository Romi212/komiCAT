<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="KomiCAT" Manufacturer="Romi" Version="1.0.0"
           UpgradeCode="749ff07f-5421-4ee7-a1c8-adc252ba2660" Scope="perUser">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="KomiCAT">
        <Files Include="dist\KomiCAT\**" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="AppShortcut" Name="KomiCAT"
                  Target="[INSTALLFOLDER]KomiCAT.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\KomiCAT"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

  </Package>
</Wix>